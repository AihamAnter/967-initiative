# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. NEVER prefix with NEXT_PUBLIC_ or commit to Git.
SUPABASE_SERVICE_ROLE_KEY=
# Set to your actual production URL after deployment
NEXT_PUBLIC_SITE_URL=https://967-initiative.vercel.app
# Optional but strongly recommended anti-spam protection for public contact form
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional server-only HMAC secret for shared contact limits. Defaults to the
# server service-role key; never expose it with NEXT_PUBLIC_.
CONTACT_RATE_LIMIT_SECRET=

# Optional: send one-to-one messages from the management-only /admin/users page.
# Use a Resend API key and a sender on a verified domain. Server-side secrets
# only; without them management can open its local mail client instead.
RESEND_API_KEY=
MANAGEMENT_EMAIL_FROM=
MANAGEMENT_EMAIL_REPLY_TO=
